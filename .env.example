# ---------------------------------------------------------------------------
# AgriVision environment
#
# Copy to `.env` and fill in the values you need. Every variable is optional:
# without them the app still runs, it just degrades gracefully (see below).
# ---------------------------------------------------------------------------

# Resend API key — enables real email delivery of alert digests.
# Without it, digests are recorded as `logged` in the delivery log instead of
# being sent. The app never pretends an email was delivered.
RESEND_API_KEY=

# Verified sender address for outgoing email (e.g. alerts@your-domain.com).
NOTIFICATION_FROM=AgriVision <alerts@example.com>

# Optional: comma-separated recipient list used by the scheduled digest.
# Defaults to the address configured in Settings > Notifications.
DIGEST_RECIPIENTS=

# ---------------------------------------------------------------------------
# Cloudflare bindings (configured in wrangler.jsonc, not here)
#
#   d1_databases: DB -> agrivision  (key/value `app_state` table)
#
# The app keeps all state in memory and writes through to D1 when the `DB`
# binding is present. It runs fine without D1 — state simply resets on cold
# start.
# ---------------------------------------------------------------------------
